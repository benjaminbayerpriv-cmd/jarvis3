{
  "manifest_version": 3,
  "name": "Web-Bildschirmmarker",
  "description": "Umrandet und beschriftet sichtbare Bedienelemente auf Webseiten.",
  "version": "1.0.0",
  "minimum_chrome_version": "119",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Web-Bildschirmmarker ein- oder ausschalten",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}

{
  "manifest_version": 3,
  "name": "Jarvis",
  "description": "Verbindet Chrome mit Jarvis und markiert Bedienelemente auf Wunsch.",
  "version": "1.2.0",
  "minimum_chrome_version": "119",
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "webNavigation",
    "debugger",
    "scripting"
  ],
  "action": {
    "default_title": "Jarvis-Markierungen einschalten",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ]
}

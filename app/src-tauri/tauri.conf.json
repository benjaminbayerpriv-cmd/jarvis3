{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis3",
  "version": "0.1.0",
  "identifier": "de.jarvis3.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Jarvis3",
        "width": 1100,
        "height": 760,
        "minWidth": 380,
        "minHeight": 560,
        "decorations": false,
        "dragDropEnabled": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:7777; frame-src http://127.0.0.1:7777 http://*.localhost:7777; connect-src ipc: http://ipc.localhost http://127.0.0.1:7777 ws://127.0.0.1:7777"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
